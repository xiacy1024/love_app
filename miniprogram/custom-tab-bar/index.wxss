.tab-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: linear-gradient(180deg, #fffdfd 0%, #fff4f6 100%);
    border-top: 2rpx solid rgba(224, 90, 115, 0.10);
    box-shadow: 0 -8rpx 28rpx rgba(120, 60, 75, 0.10);
}

.tab-bar::before {
    content: '';
    position: absolute;
    top: 0;
    left: 15%;
    right: 15%;
    height: 3rpx;
    border-radius: 3rpx;
    background: linear-gradient(90deg, rgba(224, 90, 115, 0) 0%, #e05a73 50%, rgba(224, 90, 115, 0) 100%);
}

.login-strip {
    display: flex;
    height: 68rpx;
    align-items: center;
    justify-content: center;
    border-bottom: 2rpx solid rgba(224, 90, 115, 0.08);
    background: rgba(255, 248, 249, 0.7);
}

.login-dot {
    width: 12rpx;
    height: 12rpx;
    margin-right: 12rpx;
    border-radius: 50%;
    background: #6fc59a;
}

.login-text {
    color: #8a7f84;
    font-size: 23rpx;
}

.logout-button {
    margin-left: 26rpx;
    padding: 8rpx 26rpx;
    border: 2rpx solid #f5d3da;
    border-radius: 30rpx;
    background: linear-gradient(155deg, #ffffff 0%, #fff1f4 100%);
    color: #d95270;
    font-size: 22rpx;
    line-height: 1.2;
}

.tab-items {
    display: flex;
    height: 110rpx;
    align-items: center;
}

.tab-item {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
}

.tab-icon {
    width: 44rpx;
    height: 44rpx;
    margin-bottom: 4rpx;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 40rpx 40rpx;
}

.tab-0 .tab-icon { background-image: url("data:image/png;base64,"); }

.tab-0.tab-active .tab-icon { background-image: url("data:image/png;base64,"); }

.tab-1 .tab-icon { background-image: url("data:image/png;base64,"); }

.tab-1.tab-active .tab-icon { background-image: url("data:image/png;base64,"); }

.tab-2 .tab-icon { background-image: url("data:image/png;base64,"); }

.tab-2.tab-active .tab-icon { background-image: url("data:image/png;base64,"); }

.tab-3 .tab-icon { background-image: url("data:image/png;base64,"); }

.tab-3.tab-active .tab-icon { background-image: url("data:image/png;base64,"); }

.tab-label {
    color: #9aa0a8;
    font-size: 22rpx;
    line-height: 1.2;
}

.tab-active .tab-label {
    color: #e05a73;
    font-size: 23rpx;
    font-weight: 600;
}

.tab-active::after {
    content: '';
    position: absolute;
    bottom: 10rpx;
    width: 8rpx;
    height: 8rpx;
    border-radius: 50%;
    background: #e05a73;
}
