.tab-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    border-top: 2rpx solid #f6f1f2;
    background: #ffffff;
    box-shadow: 0 -6rpx 24rpx rgba(120, 60, 75, 0.06);
}

.login-strip {
    display: flex;
    height: 68rpx;
    align-items: center;
    justify-content: center;
    border-bottom: 2rpx solid #faf3f5;
    background: #fff8f9;
}

.login-dot {
    width: 12rpx;
    height: 12rpx;
    margin-right: 12rpx;
    border-radius: 50%;
    background: #6fc59a;
}

.login-text {
    color: #8a7f84;
    font-size: 23rpx;
}

.logout-button {
    margin-left: 26rpx;
    padding: 8rpx 26rpx;
    border: 2rpx solid #f5d3da;
    border-radius: 30rpx;
    background: #ffffff;
    color: #d95270;
    font-size: 22rpx;
    line-height: 1.2;
}

.tab-items {
    display: flex;
    height: 100rpx;
}

.tab-item {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
}

.tab-label {
    color: #8a8f99;
    font-size: 26rpx;
}

.tab-active .tab-label {
    color: #e05a73;
    font-size: 27rpx;
    font-weight: 600;
}
