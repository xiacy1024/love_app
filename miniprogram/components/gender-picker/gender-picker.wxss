.gender-mask {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 120;
    display: flex;
    align-items: flex-end;
    background: rgba(28, 20, 24, 0.48);
}

.gender-panel {
    box-sizing: border-box;
    width: 100%;
    padding: 52rpx 40rpx 56rpx;
    border-radius: 36rpx 36rpx 0 0;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.gender-badge {
    display: flex;
    width: 88rpx;
    height: 88rpx;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #ffe9ed;
    color: #e05a73;
    font-size: 30rpx;
    font-weight: 600;
}

.gender-title {
    margin-top: 24rpx;
    font-size: 36rpx;
    font-weight: 600;
}

.gender-desc {
    margin-top: 14rpx;
    color: #8a8f99;
    font-size: 25rpx;
    line-height: 1.6;
    text-align: center;
}

.gender-options {
    display: flex;
    width: 100%;
    gap: 24rpx;
    margin-top: 40rpx;
}

.gender-option {
    box-sizing: border-box;
    flex: 1;
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 34rpx 12rpx;
    border: 2rpx solid #f0dfe3;
    border-radius: 24rpx;
    background: #fffafb;
}

.gender-option-active {
    border-color: #e05a73;
    background: #fff0f3;
}

.option-glyph {
    color: #e05a73;
    font-size: 64rpx;
    line-height: 1;
}

.option-label {
    margin-top: 16rpx;
    font-size: 32rpx;
    font-weight: 600;
}

.option-desc {
    margin-top: 8rpx;
    color: #a89ea3;
    font-size: 22rpx;
}

.gender-cancel {
    margin-top: 30rpx;
    padding: 12rpx 32rpx;
    color: #8a8f99;
    font-size: 26rpx;
}
