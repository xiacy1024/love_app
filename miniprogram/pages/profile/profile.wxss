.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 36rpx 28rpx 200rpx;
}

.page-head {
    display: flex;
    flex-direction: column;
    margin-bottom: 30rpx;
}

.page-title {
    font-size: 42rpx;
    font-weight: 700;
}

.page-sub {
    margin-top: 10rpx;
    color: #a89ea3;
    font-size: 25rpx;
}

.guest-card {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 80rpx 48rpx;
    border-radius: 28rpx;
    background: linear-gradient(155deg, #fffbfc 0%, #fff1f4 100%);
    text-align: center;
}

.guest-icon {
    display: flex;
    width: 120rpx;
    height: 120rpx;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #ffe9ed;
    color: #e05a73;
    font-size: 64rpx;
}

.guest-title {
    margin-top: 32rpx;
    font-size: 34rpx;
    font-weight: 600;
}

.guest-desc {
    margin-top: 16rpx;
    color: #9a8f94;
    font-size: 26rpx;
    line-height: 1.8;
}

.guest-button {
    width: 100%;
    height: 88rpx;
    margin-top: 48rpx;
    border-radius: 44rpx;
    background: #e05a73;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    text-align: center;
    line-height: 88rpx;
}

.form-card {
    padding: 8rpx 32rpx 24rpx;
    border-radius: 28rpx;
    background: linear-gradient(155deg, #fffbfc 0%, #fff1f4 100%);
}

.photo-row {
    display: flex;
    align-items: center;
    padding: 28rpx 0;
    border-bottom: 2rpx solid #f7e6ea;
}

.photo-box {
    display: flex;
    width: 120rpx;
    height: 120rpx;
    align-items: center;
    justify-content: center;
    border-radius: 20rpx;
    background: #fff0f3;
    overflow: hidden;
}

.photo-preview {
    width: 100%;
    height: 100%;
}

.photo-plus {
    color: #e05a73;
    font-size: 60rpx;
    line-height: 1;
}

.photo-tip {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin-left: 24rpx;
}

.photo-title {
    font-size: 29rpx;
    font-weight: 500;
}

.photo-sub {
    margin-top: 10rpx;
    color: #a89ea3;
    font-size: 23rpx;
}

.row-arrow {
    color: #c8bfc3;
    font-size: 40rpx;
}

.field-row {
    display: flex;
    min-height: 100rpx;
    align-items: center;
    border-bottom: 2rpx solid #f7e6ea;
    background: #ffffff
    
    ;
}

.field-label {
    width: 180rpx;
    color: #6f666b;
    font-size: 27rpx;
}

.field-input {
    flex: 1;
    font-size: 28rpx;
    color: #2b2b33;
}

.field-value {
    flex: 1;
    font-size: 28rpx;
}

.field-placeholder {
    color: #c2b8bd;
}

.unit {
    color: #a89ea3;
    font-size: 25rpx;
}

.vip-row switch {
    transform: scale(0.85);
    transform-origin: right center;
}

.intro-row {
    display: flex;
    flex-direction: column;
    padding: 28rpx 0 8rpx;
}

.field-textarea {
    width: 100%;
    min-height: 160rpx;
    margin-top: 16rpx;
    padding: 20rpx;
    box-sizing: border-box;
    border-radius: 16rpx;
    background: #eef6f1;
    color: #3f5c50;
    font-size: 27rpx;
    line-height: 1.7;
}

.error-text {
    margin-top: 24rpx;
    color: #d9485f;
    font-size: 25rpx;
    text-align: center;
}

.save-button {
    height: 92rpx;
    margin-top: 32rpx;
    border-radius: 46rpx;
    background: #e05a73;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    text-align: center;
    line-height: 92rpx;
}

.save-disabled {
    opacity: 0.6;
}

.footer-note {
    margin-top: 20rpx;
    color: #b3a8ad;
    font-size: 22rpx;
    text-align: center;
}
