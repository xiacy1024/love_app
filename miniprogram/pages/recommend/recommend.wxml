<view class="page" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
    <view class="top-bar">
        <view class="brand">
            <text class="brand-name">遇见</text>
            <text class="brand-sub">发现合适的人</text>
        </view>
        <view class="top-right">
            <view class="preference-chip" bindtap="openGenderPicker">
                <text class="preference-text">{{preferenceText || '选择性别'}}</text>
                <text class="preference-arrow">›</text>
            </view>
            <view class="progress">{{progressText}}</view>
        </view>
    </view>

    <view class="state-card" wx:if="{{viewState === 'loading'}}">
        <view class="spinner"></view>
        <text class="state-title">正在寻找候选人</text>
        <text class="state-description">马上就好，请稍候。</text>
    </view>

    <view class="state-card" wx:elif="{{viewState === 'empty'}}">
        <text class="state-icon">○</text>
        <text class="state-title">暂时没有推荐</text>
        <text class="state-description">稍后再来看看，或完善资料获得更精准的推荐。</text>
        <view class="state-button" bindtap="handleRetry">重新加载</view>
    </view>

    <view class="state-card state-card-error" wx:elif="{{viewState === 'error'}}">
        <text class="state-icon">!</text>
        <text class="state-title">加载失败</text>
        <text class="state-description">请检查网络或后端接口后重试。</text>
        <view class="state-button" bindtap="handleRetry">重新加载</view>
    </view>

    <block wx:elif="{{current}}">
        <view class="candidate-card {{switchClass}}">
            <view class="photo-wrap">
                <image wx:if="{{current.image_url}}" class="photo" src="{{current.image_url}}" mode="aspectFill"></image>
                <view wx:else class="photo photo-placeholder">
                    <view class="placeholder-circle"></view>
                    <text class="placeholder-initial">{{current.initial}}</text>
                </view>
                <view class="photo-shade"></view>
                <view class="photo-info">
                    <view class="name-row">
                        <text class="candidate-name">{{current.name}}</text>
                        <view wx:if="{{current.isVip}}" class="vip-tag">VIP</view>
                    </view>
                    <view class="meta-row">
                        <text class="age-tag">{{current.ageText}}</text>
                        <text class="meta-text">{{current.genderText}}</text>
                        <text class="meta-dot">·</text>
                        <text class="meta-text">{{current.current_city}}</text>
                    </view>
                </view>
            </view>

            <view class="detail-section">
                <view class="section-heading">
                    <text class="section-title">基本资料</text>
                    <text class="section-note">向下滑动查看更多</text>
                </view>
                <view class="info-grid">
                    <view class="info-item">
                        <text class="info-label">学历</text>
                        <text class="info-value">{{current.educationText}}</text>
                    </view>
                    <view class="info-item">
                        <text class="info-label">收入</text>
                        <text class="info-value">{{current.incomeText}}</text>
                    </view>
                    <view class="info-item">
                        <text class="info-label">生日</text>
                        <text class="info-value">{{current.birthday}}</text>
                    </view>
                    <view class="info-item info-item-wide">
                        <text class="info-label">职业</text>
                        <text class="info-value">{{current.job}}</text>
                    </view>
                    <view class="info-item info-item-wide">
                        <text class="info-label">毕业院校</text>
                        <text class="info-value">{{current.school}}</text>
                    </view>
                </view>

                <view class="intro-card">
                    <text class="intro-title">关于 TA</text>
                    <text class="intro-text">{{current.self_intro}}</text>
                </view>

                <view class="match-card">
                    <view class="match-row">
                        <text class="match-title">匹配度</text>
                        <text class="match-value">{{current.matchText}}</text>
                    </view>
                    <view class="match-track">
                        <view class="match-fill" style="width: {{current.matchText}};"></view>
                    </view>
                </view>
            </view>
        </view>

        <view class="swipe-hint" bindtap="nextCandidate">
            <text>右滑查看下一位</text>
            <text class="hint-arrow">→</text>
        </view>
    </block>

    <view class="floating-actions" wx:if="{{viewState === 'ready'}}">
        <view class="action-btn action-dislike" bindtap="handleDislike">
            <text class="action-glyph">×</text>
            <text class="action-label">不合适</text>
        </view>
        <view class="action-btn action-like" bindtap="handleLike">
            <text class="action-glyph">♥</text>
            <text class="action-label">喜欢</text>
        </view>
    </view>

    <login-sheet show="{{showLogin}}" bind:login="handleLogin" bind:close="closeLogin"></login-sheet>
    <gender-picker show="{{showGenderPicker}}" selected="{{preferredGender}}" required="{{genderRequired}}" bind:confirm="handleGenderConfirm" bind:close="closeGenderPicker"></gender-picker>
</view>
