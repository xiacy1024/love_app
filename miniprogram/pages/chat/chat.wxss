.page {
    min-height: 100vh;
    padding: 32rpx 28rpx 60rpx;
    box-sizing: border-box;
    background: #fff6f7;
}

.page-head {
    margin-bottom: 28rpx;
}

.page-title {
    display: block;
    color: #2b2b33;
    font-size: 40rpx;
    font-weight: 600;
}

.page-sub {
    display: block;
    margin-top: 8rpx;
    color: #a89ea3;
    font-size: 24rpx;
}

.state-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 420rpx;
    padding: 40rpx;
    background: linear-gradient(155deg, #fffbfc 0%, #fff1f4 100%);
    border-radius: 20rpx;
}

.state-icon {
    color: #e05a73;
    font-size: 72rpx;
    line-height: 1;
    margin-bottom: 20rpx;
}

.state-title {
    color: #2b2b33;
    font-size: 30rpx;
    font-weight: 600;
}

.state-description {
    margin-top: 12rpx;
    color: #a89ea3;
    font-size: 24rpx;
    text-align: center;
}

.state-button {
    margin-top: 32rpx;
    padding: 18rpx 48rpx;
    border-radius: 40rpx;
    background: #e05a73;
    color: #ffffff;
    font-size: 26rpx;
}

.spinner {
    width: 48rpx;
    height: 48rpx;
    border: 4rpx solid #f4c0d1;
    border-top-color: #e05a73;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 20rpx;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.session-list {
    background: #ffffff;
    border-radius: 20rpx;
    overflow: hidden;
}

.session-item {
    display: flex;
    align-items: center;
    padding: 28rpx 24rpx;
    border-bottom: 2rpx solid #f7e6ea;
}

.session-item:last-child {
    border-bottom: none;
}

.session-item:active {
    background: #f5f7fa;
}

.session-avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: 20rpx;
}

.session-avatar-img {
    width: 100%;
    height: 100%;
}

.session-avatar-text {
    color: #ffffff;
    font-size: 34rpx;
    font-weight: 600;
}

.session-body {
    flex: 1;
    min-width: 0;
}

.session-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.session-name {
    color: #2b2b33;
    font-size: 30rpx;
    font-weight: 600;
}

.session-time {
    color: #b3a8ad;
    font-size: 22rpx;
    flex-shrink: 0;
    margin-left: 16rpx;
}

.session-preview {
    display: block;
    margin-top: 10rpx;
    color: #8a8f99;
    font-size: 26rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.chat-mask {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
}

.chat-panel {
    width: 88%;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    padding: 28rpx;
    background: #ffffff;
    border-radius: 24rpx;
    box-sizing: border-box;
}

.chat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: -28rpx -28rpx 0;
    padding: 28rpx 28rpx 20rpx;
    border-radius: 24rpx 24rpx 0 0;
    background: linear-gradient(155deg, #fff3f6 0%, #ffe9f0 100%);
    border-bottom: 2rpx solid #f5d9e1;
}

.chat-title {
    color: #2b2b33;
    font-size: 30rpx;
    font-weight: 600;
}

.chat-close {
    color: #b3a8ad;
    font-size: 44rpx;
    line-height: 1;
}

.chat-loading,
.chat-empty {
    padding: 80rpx 0;
    color: #a89ea3;
    font-size: 26rpx;
    text-align: center;
}

.chat-list {
    max-height: 60vh;
    padding: 24rpx 12rpx 24rpx 0;
    overflow-y: auto;
}

.chat-list::-webkit-scrollbar {
    width: 6rpx;
}

.chat-list::-webkit-scrollbar-track {
    background: transparent;
    border-radius: 6rpx;
}

.chat-list::-webkit-scrollbar-thumb {
    background: #eec3ce;
    border-radius: 6rpx;
}

.chat-list::-webkit-scrollbar-thumb:active {
    background: #e05a73;
}

.chat-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 20rpx;
}

.chat-self {
    justify-content: flex-end;
}

.chat-other {
    justify-content: flex-start;
}

.chat-avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.chat-avatar-img {
    width: 100%;
    height: 100%;
}

.chat-avatar-text {
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 600;
}

.chat-other .chat-avatar {
    margin-right: 14rpx;
}

.chat-self .chat-avatar {
    margin-left: 14rpx;
}

.chat-main {
    display: flex;
    flex-direction: column;
    max-width: 72%;
}

.chat-self .chat-main {
    align-items: flex-end;
}

.chat-time {
    color: #b3a8ad;
    font-size: 20rpx;
    margin-bottom: 6rpx;
}

.chat-bubble {
    max-width: 100%;
    padding: 16rpx 22rpx;
    border-radius: 18rpx;
    background: linear-gradient(155deg, #eef4fb 0%, #e2ebf7 100%);
    color: #334155;
    font-size: 26rpx;
    line-height: 1.6;
    word-break: break-all;
}

.chat-self .chat-bubble {
    background: #e05a73;
    color: #ffffff;
}
